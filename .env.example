# =============================================================
# Trading Expert — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# --- DeepSeek API ---
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram, then paste the token:
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Your Telegram user ID (bot sends alerts to this ID):
# Get it by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- News APIs ---
# Get your key at: https://newsapi.org/register
NEWSAPI_KEY=your-newsapi-key
# Get your key at: https://gnews.io/
GNEWS_API_KEY=your-gnews-key

# --- Database ---
# SQLite (default, no config needed)
DATABASE_URL=sqlite:///data/trading.db
# For Postgres later: postgresql://user:pass@host:5432/trading_expert

# --- Redis ---
REDIS_URL=redis://redis:6379/0
